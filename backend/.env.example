ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://awd:CHANGE_ME@postgres:5432/awd
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
POSTGRES_DB=awd
POSTGRES_USER=awd
POSTGRES_PASSWORD=CHANGE_ME
PGHOST=postgres
PGPORT=5432
PGDATABASE=awd
PGUSER=awd
PGPASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_WITH_32_PLUS_RANDOM_BYTES
FLAG_HMAC_SECRET=CHANGE_ME_WITH_32_PLUS_RANDOM_BYTES
SESSION_SECURE_COOKIE=true
SESSION_TTL_SECONDS=86400
ALLOW_IN_MEMORY_REDIS=false
ALLOW_MOCK_DOCKER=false
MOCK_TARGET_ROOT=/tmp/awd-targets
MATCH_ROUND_SECONDS=300
FLAG_GRACE_SECONDS=30
INITIAL_TEAM_SCORE=1000
ATTACK_REWARD=100
VICTIM_PENALTY=50
HEALTH_INTERVAL_SECONDS=30
MAX_AUTO_RESTARTS=2
FLAG_SUBMIT_RATE_PER_SECOND=10
TERMINAL_SSH_USERNAME=player
TERMINAL_SSH_PASSWORD=CHANGE_ME
LOG_LEVEL=INFO
